generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "dialog", "exchange"]
}

// =============================================
// ENUMS - Dialog Schema
// =============================================

enum MessageType {
  TEXT
  IMAGE
  AUDIO

  @@schema("dialog")
}

enum AiMessageRole {
  USER
  ASSISTANT

  @@schema("dialog")
}

// =============================================
// ENUMS - Exchange Schema
// =============================================

enum UserRole {
  user
  moderator
  admin

  @@schema("core")
}

enum AccountStatus {
  active
  suspended
  closed

  @@schema("core")
}

enum ListingStatus {
  active
  sold
  expired
  deleted

  @@schema("exchange")
}

// =============================================
// CORE SCHEMA - Users & Identity
// =============================================

model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()::text"))
  org_default_id String?
  username       String        @unique
  email          String        @unique
  email_hash     String        @unique
  email_verified Boolean       @default(false)
  display_name   String?
  avatar_url     String?
  password       String
  role           UserRole      @default(user)
  account_status AccountStatus @default(active)
  is_active      Boolean       @default(true)
  deleted_at     DateTime?     @db.Timestamp(3)
  created_at     DateTime      @default(now()) @db.Timestamp(3)
  updated_at     DateTime      @default(now()) @db.Timestamp(3)

  // Relations - Dialog
  messagesSent     Message[]  @relation("MessageSender")
  messagesReceived Message[]  @relation("MessageReceiver")
  aiThreads        AiThread[]
  pii              UserPII?

  // Relations - Exchange
  profile       Profile?
  listings      Listing[]
  savedListings SavedListing[]

  @@map("users")
  @@schema("core")
}

model UserPII {
  user_id    String    @id
  email      String
  phone      String?
  legal_name String?
  address    String?
  deleted_at DateTime? @db.Timestamp(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_pii")
  @@schema("core")
}

// =============================================
// DIALOG SCHEMA - Messages & AI Conversations
// =============================================

model Message {
  id          String      @id @default(dbgenerated("gen_random_uuid()::text"))
  sender_id   String
  receiver_id String
  content     String?
  type        MessageType @default(TEXT)
  media_url   String?
  created_at  DateTime    @default(now()) @db.Timestamp(3)

  sender   User @relation("MessageSender", fields: [sender_id], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiver_id], references: [id])

  @@index([sender_id])
  @@index([receiver_id])
  @@index([created_at(sort: Desc)])
  @@map("messages")
  @@schema("dialog")
}

model AiThread {
  id                  String   @id @default(dbgenerated("gen_random_uuid()::text"))
  user_id             String
  title               String?
  langgraph_thread_id String   @unique
  created_at          DateTime @default(now()) @db.Timestamp(3)
  updated_at          DateTime @default(now()) @db.Timestamp(3)

  user     User        @relation(fields: [user_id], references: [id])
  messages AiMessage[]

  @@index([user_id, updated_at])
  @@map("ai_threads")
  @@schema("dialog")
}

model AiMessage {
  id                String        @id @default(dbgenerated("gen_random_uuid()::text"))
  thread_id         String
  role              AiMessageRole
  content           String
  emotion_score     Int?
  emotion_label     String?
  emotion_reasoning String?
  created_at        DateTime      @default(now()) @db.Timestamp(3)

  thread AiThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([thread_id, created_at])
  @@map("ai_messages")
  @@schema("dialog")
}

// =============================================
// EXCHANGE SCHEMA - Marketplace & Listings
// =============================================

model Profile {
  id               String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("profile_id")
  user_id          String   @unique
  display_name     String?
  bio              String?
  avatar_url       String?
  location_city    String?
  location_country String?
  location_lat     Decimal? @db.Decimal(10, 7)
  location_lng     Decimal? @db.Decimal(10, 7)
  created_at       DateTime @default(now()) @db.Timestamp(3)
  updated_at       DateTime @default(now()) @db.Timestamp(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
  @@schema("exchange")
}

model Listing {
  id                   String        @id @default(dbgenerated("gen_random_uuid()::text")) @map("listing_id")
  seller_id            String
  engine_source        String        @default("marketplace") @db.VarChar(50)
  title                String        @db.VarChar(255)
  description          String?
  price                Decimal?      @db.Decimal(12, 2)
  currency             String?       @db.VarChar(10)
  category             String?       @db.VarChar(100)
  status               ListingStatus @default(active)
  credibility_indicator String?      @db.VarChar(50)
  integrity_flags      String?
  latitude             Decimal?      @db.Decimal(10, 8)
  longitude            Decimal?      @db.Decimal(11, 8)
  location_name        String?       @db.VarChar(255)
  images               Json          @default("[]")
  created_at           DateTime      @default(now()) @db.Timestamp(3)
  updated_at           DateTime      @default(now()) @db.Timestamp(3)

  seller        User           @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  savedListings SavedListing[]

  @@index([seller_id])
  @@index([status])
  @@index([category])
  @@index([created_at(sort: Desc)])
  @@map("listings")
  @@schema("exchange")
}

model SavedListing {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("saved_listing_id")
  user_id    String
  listing_id String
  created_at DateTime @default(now()) @db.Timestamp(3)
  updated_at DateTime @default(now()) @db.Timestamp(3)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@map("saved_listings")
  @@schema("exchange")
}

