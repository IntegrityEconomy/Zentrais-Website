generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "dialog"]
}

// =============================================
// ENUMS - Matching SQL schema exactly
// =============================================

enum MessageType {
  TEXT
  IMAGE
  AUDIO

  @@schema("dialog")
}

enum AiMessageRole {
  USER
  ASSISTANT

  @@schema("dialog")
}

// =============================================
// CORE SCHEMA - Users & Identity
// =============================================

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()::text"))
  org_default_id String?
  username       String    @unique
  email          String    @unique
  email_hash     String    @unique
  email_verified Boolean   @default(false)
  display_name   String?
  avatar_url     String?
  password       String
  is_active      Boolean   @default(true)
  deleted_at     DateTime? @db.Timestamp(3)
  created_at     DateTime  @default(now()) @db.Timestamp(3)
  updated_at     DateTime  @default(now()) @db.Timestamp(3)

  // Relations
  messagesSent     Message[]  @relation("MessageSender")
  messagesReceived Message[]  @relation("MessageReceiver")
  aiThreads        AiThread[]
  pii              UserPII?

  @@map("users")
  @@schema("core")
}

model UserPII {
  user_id    String    @id
  email      String
  phone      String?
  legal_name String?
  address    String?
  deleted_at DateTime? @db.Timestamp(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_pii")
  @@schema("core")
}

// =============================================
// DIALOG SCHEMA - Messages & AI Conversations
// =============================================

model Message {
  id          String      @id @default(dbgenerated("gen_random_uuid()::text"))
  sender_id   String
  receiver_id String
  content     String?
  type        MessageType @default(TEXT)
  media_url   String?
  created_at  DateTime    @default(now()) @db.Timestamp(3)

  sender   User @relation("MessageSender", fields: [sender_id], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiver_id], references: [id])

  @@index([sender_id])
  @@index([receiver_id])
  @@index([created_at(sort: Desc)])
  @@map("messages")
  @@schema("dialog")
}

model AiThread {
  id                  String   @id @default(dbgenerated("gen_random_uuid()::text"))
  user_id             String
  title               String?
  langgraph_thread_id String   @unique
  created_at          DateTime @default(now()) @db.Timestamp(3)
  updated_at          DateTime @default(now()) @db.Timestamp(3)

  user     User        @relation(fields: [user_id], references: [id])
  messages AiMessage[]

  @@index([user_id, updated_at])
  @@map("ai_threads")
  @@schema("dialog")
}

model AiMessage {
  id                String        @id @default(dbgenerated("gen_random_uuid()::text"))
  thread_id         String
  role              AiMessageRole
  content           String
  emotion_score     Int?
  emotion_label     String?
  emotion_reasoning String?
  created_at        DateTime      @default(now()) @db.Timestamp(3)

  thread AiThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([thread_id, created_at])
  @@map("ai_messages")
  @@schema("dialog")
}

