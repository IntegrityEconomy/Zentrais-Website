REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-here

# Server port - MUST be different from Next.js (3000)
PORT=3001

# Database Configuration
# Local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zentrais?search_path=core,dialog,exchange,public

# AWS RDS (production example)
# DATABASE_URL=postgresql://user:password@your-rds-endpoint.region.rds.amazonaws.com:5432/dbname?schema=public

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
ACCOUNT_ID=your-aws-account-id

# AWS Credentials (for local development only)
# On AWS ECS/EC2/Lambda, SDK will use IAM role automatically - do NOT set these
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# LangGraph service URL (used by NestJS AI proxy)
LANGGRAPH_URL=http://localhost:8000

# OpenAI API Key (for LangGraph Python service)
# In production, use AWS Secrets Manager instead
OPENAI_API_KEY=your-openai-api-key
