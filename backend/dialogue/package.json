  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.0",
    "dayjs": "^1.x.x",
    "multer": "^1.4.5-lts.1",
    "passport-jwt": "^4.0.1",
    "redis": "^4.6.7",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.1.3"
  }
