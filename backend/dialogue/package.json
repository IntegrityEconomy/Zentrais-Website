{
  "name": "chat-engine",
  "version": "1.0.0",
  "main": "dist/main.js",
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run start:dev",
    "start:dev": "nest start --watch",
