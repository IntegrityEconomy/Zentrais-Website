generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "dialog", "public"]
}

model AiMessage {
  id               String        @id
  threadId         String
  role             AiMessageRole
  content          String
  emotionScore     Int?
  emotionLabel     String?
  emotionReasoning String?
  createdAt        DateTime      @default(now())
  AiThread         AiThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@schema("public")
}

model AiThread {
  id                String      @id
  userId            String
  title             String?
  langgraphThreadId String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime
  AiMessage         AiMessage[]
  User              User        @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
  @@schema("public")
}

model Message {
  id                            String      @id
  senderId                      String
  receiverId                    String
  content                       String?
  createdAt                     DateTime    @default(now())
  mediaUrl                      String?
  type                          MessageType @default(TEXT)
  User_Message_receiverIdToUser User        @relation("Message_receiverIdToUser", fields: [receiverId], references: [id])
  User_Message_senderIdToUser   User        @relation("Message_senderIdToUser", fields: [senderId], references: [id])

  @@schema("public")
}

model User {
  id                               String     @id
  username                         String     @unique
  password                         String
  createdAt                        DateTime   @default(now())
  avatar_url                       String?
  created_at                       DateTime   @default(now())
  deleted_at                       DateTime?
  display_name                     String?
  email                            String     @unique
  email_hash                       String     @unique
  email_verified                   Boolean    @default(false)
  is_active                        Boolean    @default(true)
  org_default_id                   String?
  updated_at                       DateTime
  AiThread                         AiThread[]
  Message_Message_receiverIdToUser Message[]  @relation("Message_receiverIdToUser")
  Message_Message_senderIdToUser   Message[]  @relation("Message_senderIdToUser")
  User_PII                         User_PII?

  @@schema("public")
}

model User_PII {
  user_id    String  @id
  email      String
  phone      String?
  legal_name String?
  address    String?
  User       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO

  @@schema("public")
}

enum AiMessageRole {
  USER
  ASSISTANT

  @@schema("public")
}
