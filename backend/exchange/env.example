# Exchange Backend Environment Variables

# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration - MUST match Dialogue backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zentrais?search_path=core,dialog,exchange,public

# JWT Configuration - MUST match Dialogue backend for unified auth
JWT_SECRET=your-jwt-secret-here

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
ACCOUNT_ID=your-aws-account-id

# AWS Credentials (for local development only)
# On AWS ECS/EC2/Lambda, SDK will use IAM role automatically - do NOT set these
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
